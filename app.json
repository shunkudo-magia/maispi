{
  "expo": {
    "name": "まいすぴ",
    "slug": "maispi",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#fbe7ef"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.jp.magia.maispi"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fbe7ef"
      },
      "package": "co.jp.magia.maispi"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": []
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#da668e"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "maispi"
  }
}
